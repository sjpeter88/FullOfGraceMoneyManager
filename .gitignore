## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022/2026 cache/options directory
.vs/

# WebView2 User Data Folders
*.exe.WebView2/
WebView2/

# Local SQLite database files and journals
*.db
!FullofGraceMoneyManager.Desktop/Data/fullofgrace.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# .NET Core / .NET 10
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# JetBrains Rider
.idea/
*.sln.iml

# OS & environment dotfiles
.DS_Store
Thumbs.db
