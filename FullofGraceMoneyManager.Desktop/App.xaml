<Application x:Class="FullofGraceMoneyManager.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Sunrise Dark Aesthetic Palette -->
        <Color x:Key="BgDeepSlateColor">#0B0F19</Color>
        <Color x:Key="BgSurfaceColor">#111827</Color>
        <Color x:Key="BgElevatedColor">#1E293B</Color>
        <Color x:Key="BgHoverColor">#273549</Color>
        <Color x:Key="BorderSubtleColor">#293548</Color>
        <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
        <Color x:Key="TextSecondaryColor">#94A3B8</Color>
        <Color x:Key="TextMutedColor">#64748B</Color>
        <Color x:Key="AccentGoldColor">#F59E0B</Color>
        <Color x:Key="AccentSkyBlueColor">#38BDF8</Color>
        <Color x:Key="AccentEmeraldColor">#10B981</Color>
        <Color x:Key="AccentRoseColor">#F43F5E</Color>

        <SolidColorBrush x:Key="BgDeepSlateBrush" Color="{StaticResource BgDeepSlateColor}" />
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
        <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}" />
        <SolidColorBrush x:Key="AccentSkyBlueBrush" Color="{StaticResource AccentSkyBlueColor}" />
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmeraldColor}" />
        <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRoseColor}" />

        <LinearGradientBrush x:Key="SunriseHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F59E0B" Offset="0.0" />
            <GradientStop Color="#38BDF8" Offset="0.55" />
            <GradientStop Color="#6366F1" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SunriseCardAccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1F2937" Offset="0.0" />
            <GradientStop Color="#111827" Offset="0.7" />
            <GradientStop Color="#172554" Offset="1.0" />
        </LinearGradientBrush>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Toolbar Action Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentSkyBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Gold CTA Button Style -->
        <Style x:Key="PrimaryGoldButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F59E0B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
